# ─────────────────────────────────────────────────────────────────────────────
# The Chronicler — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Google Books API (optional) ───────────────────────────────────────────────
# Used as fallback when Open Library ISBN lookup returns no result.
# Leave blank to use Open Library only (sufficient for most cases).
# Get a key at: https://console.cloud.google.com → Books API

VITE_GOOGLE_BOOKS_API_KEY="AIzaSyCWvTxBUSn2BFIVOEd2IFalNV4Uvo__vSA"

# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: The Gemini API key is NOT set here.
# It must be set as a Supabase Edge Function secret only:
#   supabase secrets set GEMINI_API_KEY=AIza...
# Get a free key at: https://aistudio.google.com/apikey
# Setting it here would expose it in the browser bundle.
# ─────────────────────────────────────────────────────────────────────────────
